{
  "name": "sync-service",
  "version": "1.0.0",
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "build":     "tsc",
    "start":     "node dist/index.js",
    "dev":       "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "test":      "jest",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "express":                "^4.19.2",
    "express-rate-limit":     "^7.3.1",
    "pg":                     "^8.11.5",
    "pg-logical-replication": "^3.0.0",
    "pino":                   "^8.21.0",
    "prom-client":            "^15.1.3",
    "typesense":              "^1.8.2"
  },
  "devDependencies": {
    "typescript":     "^5.4.5",
    "@types/node":    "^20.12.12",
    "@types/express": "^4.17.21",
    "@types/pg":      "^8.11.6",
    "tsx":            "^4.11.0",
    "jest":           "^29.7.0",
    "ts-jest":        "^29.1.4",
    "@types/jest":    "^29.5.12"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": ["**/__tests__/**/*.test.ts"],
    "moduleNameMapper": {
      "^./config$": "<rootDir>/src/__mocks__/config.ts"
    }
  }
}
