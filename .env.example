# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=sync_db
POSTGRES_USER=sync_user
POSTGRES_PASSWORD=sync_pass

# Typesense
TYPESENSE_HOST=typesense
TYPESENSE_PORT=8108
TYPESENSE_API_KEY=local-dev-api-key
TYPESENSE_COLLECTION=shipments

# Sync Service
PORT=3000
INITIAL_SYNC_BATCH_SIZE=100

# WAL Logical Replication (Phase 6)
REPLICATION_SLOT=sync_slot
REPLICATION_PUBLICATION=sync_pub

# Retry (Phase 7)
RETRY_MAX_ATTEMPTS=5
RETRY_INITIAL_DELAY_MS=500
RETRY_MAX_DELAY_MS=30000

# Observability (Phase 7)
LOG_LEVEL=info

# API security (optional — if set, all /shipments and /admin routes require X-Api-Key header)
# API_KEY=change-me-in-production

# Typesense search-only key (optional — use a scoped read-only key for the HTTP API)
# Create via: curl -X POST 'http://localhost:8108/keys' \
#   -H 'X-TYPESENSE-API-KEY: local-dev-api-key' \
#   -d '{"description":"Search-only","actions":["documents:search","documents:get"],"collections":["shipments"]}'
# TYPESENSE_SEARCH_API_KEY=<value from above>

# Event coalescing window in ms (default 50ms — deduplicate rapid-fire updates to the same shipment)
# COALESCE_WINDOW_MS=50

# Maximum shipment IDs buffered in the coalescer before an early flush is triggered (default 10000)
# Prevents unbounded memory growth under sustained high write load
# COALESCE_MAX_BUFFER=10000
